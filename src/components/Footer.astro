---
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

interface Props {
  locale?: Locale;
}
const { locale = 'et' } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer>
  <!-- Decorative top border -->
  <div class="flex items-center justify-center gap-3 py-6">
    <div class="h-[1px] w-20 bg-gradient-to-r from-transparent to-gold/40"></div>
    <span class="text-gold/50 text-[10px]">&#9830;</span>
    <div class="h-[1px] w-20 bg-gradient-to-l from-transparent to-gold/40"></div>
  </div>

  <div class="bg-warm-dark text-warm-white/90">
    <div class="max-w-6xl mx-auto px-6 pt-14 pb-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12">

        <!-- Brand + contact -->
        <div class="md:col-span-4">
          <h3 class="font-display text-2xl text-warm-white mb-6">{t(locale, 'footer.brand')}</h3>

          <ul class="space-y-1 font-body text-sm text-warm-white/75">
            <li>
              <a href="tel:+37254210881" class="inline-flex items-center min-h-[44px] hover:text-gold-light transition-colors">
                +372 5421 0881
              </a>
            </li>
            <li>
              <a href="mailto:info@laitsecastle.ee" class="inline-flex items-center min-h-[44px] hover:text-gold-light transition-colors">
                info@laitsecastle.ee
              </a>
            </li>
            <li class="pt-1 text-warm-white/50">
              {t(locale, 'footer.address')}
            </li>
          </ul>
          <div class="flex items-center gap-1 mt-3 -ml-2.5">
            <a
              href="https://www.facebook.com/LaitseCastle"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t(locale, 'footer.facebook')}
              class="inline-flex items-center justify-center w-11 h-11 text-warm-white/75 hover:text-gold-light transition-colors"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6" aria-hidden="true">
                <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.412c0-3.025 1.792-4.696 4.533-4.696 1.313 0 2.686.236 2.686.236v2.97H15.83c-1.49 0-1.955.93-1.955 1.886v2.265h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
              </svg>
            </a>
            <a
              href="https://www.instagram.com/laitsecastle"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t(locale, 'footer.instagram')}
              class="inline-flex items-center justify-center w-11 h-11 text-warm-white/75 hover:text-gold-light transition-colors"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Map -->
        <div class="md:col-span-8">
          <div class="w-full rounded-lg overflow-hidden shadow-lg">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2399.652899443389!2d24.38460711302241!3d59.19656527444412!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4692b74ee626aadd%3A0x2f7cebea9b79a006!2sLaitse%20loss%2C%20Laitse%2C%2076302%20Harju%20maakond%2C%20Estonia!5e1!3m2!1sen!2sus!4v1773305950212!5m2!1sen!2sus"
              width="100%"
              height="220"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={t(locale, 'footer.mapTitle')}
              class="h-[200px] md:h-[260px] w-full"
            ></iframe>
          </div>
        </div>

      </div>

      <!-- Bottom bar -->
      <div class="mt-12 pt-6 border-t border-warm-white/10 flex flex-wrap items-center justify-between gap-4">
        <p class="font-ui text-xs text-warm-white/40">
          &copy; {currentYear} Nevaliste O&Uuml;
        </p>
        <a
          href={locale === 'en' ? '/en/privacy-policy' : '/privaatsuspoliitika'}
          class="font-ui text-xs uppercase tracking-wider text-warm-white/40 hover:text-gold-light transition-colors min-h-[44px] inline-flex items-center"
        >
          {t(locale, 'footer.privacy')}
        </a>
      </div>
    </div>
  </div>
</footer>
