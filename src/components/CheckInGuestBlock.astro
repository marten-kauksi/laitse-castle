---
/**
 * One adult guest's § 24 fields.
 *
 * Rendered twice by CheckInForm: once directly (the first guest) and once inside
 * a <template> with index="__I__", which the client script string-replaces when
 * cloning. That keeps ids, `for` and `aria-describedby` unique per guest without
 * duplicating this markup.
 */
import DateField from './DateField.astro';
import { COUNTRIES } from '../lib/countries';
import { t, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** Number for the server-rendered block, '__I__' inside the template. */
  index: number | string;
  /** Guest 1 cannot be removed. */
  removable?: boolean;
}

const { locale, index, removable = false } = Astro.props;
const i = index;

// COUNTRIES ships sorted by Estonian name; re-sort for the display locale so the
// English list is alphabetical in English (otherwise "United States" lands 4th,
// where "Ameerika Ühendriigid" would be).
const collator = new Intl.Collator(locale);
const countries = [...COUNTRIES].sort((a, b) => collator.compare(a[locale], b[locale]));

const labelClass = 'block font-ui text-[16px] font-bold text-warm-dark mb-2';
const inputClass =
  'w-full font-body text-[17px] text-warm-dark bg-white border border-stone/40 rounded-sm px-4 py-3 min-h-[52px] ' +
  'transition-colors focus:outline-none focus:border-burgundy focus:ring-2 focus:ring-burgundy/25 ' +
  'aria-[invalid=true]:border-burgundy aria-[invalid=true]:ring-2 aria-[invalid=true]:ring-burgundy/25';
const errorClass = 'mt-2 font-ui text-[15px] text-burgundy font-bold empty:hidden';
---

<fieldset class="guest-block border border-stone/25 rounded-sm p-5 md:p-7 bg-warm-light/40" data-guest data-index={i}>
  <legend class="px-3 font-subtitle text-[clamp(24px,2.6vw,32px)] text-burgundy">
    {t(locale, 'checkin.guest.heading')} <span data-guest-number>{typeof i === 'number' ? i + 1 : ''}</span>
  </legend>

  {removable && (
    <div class="flex justify-end -mt-2 mb-2">
      <button
        type="button"
        data-remove-guest
        class="font-ui text-[15px] font-bold text-burgundy underline underline-offset-4 min-h-[44px] px-2 hover:text-burgundy-hover"
      >
        {t(locale, 'checkin.guest.remove')}
      </button>
    </div>
  )}

  <div class="grid gap-5 md:grid-cols-2">
    <!-- Given names -->
    <div>
      <label class={labelClass} for={`given-names-${i}`}>{t(locale, 'checkin.field.givenNames')}</label>
      <input
        type="text" id={`given-names-${i}`} data-field="given_names"
        autocomplete="given-name" maxlength="100" required
        class={`${inputClass} ph-no-capture`}
        aria-describedby={`given-names-err-${i}`}
      />
      <p class={errorClass} id={`given-names-err-${i}`} data-error role="alert"></p>
    </div>

    <!-- Surname -->
    <div>
      <label class={labelClass} for={`surname-${i}`}>{t(locale, 'checkin.field.surname')}</label>
      <input
        type="text" id={`surname-${i}`} data-field="surname"
        autocomplete="family-name" maxlength="100" required
        class={`${inputClass} ph-no-capture`}
        aria-describedby={`surname-err-${i}`}
      />
      <p class={errorClass} id={`surname-err-${i}`} data-error role="alert"></p>
    </div>

    <!-- Date of birth — three typed segments; native type=date is wheels-only on iOS -->
    <DateField
      locale={locale}
      id={`dob-${i}`}
      label={t(locale, 'checkin.field.dob')}
      field="date_of_birth"
      birthday={true}
    />

    <!-- Citizenship -->
    <div>
      <label class={labelClass} for={`citizenship-${i}`}>{t(locale, 'checkin.field.citizenship')}</label>
      <select
        id={`citizenship-${i}`} data-field="citizenship" required
        class={`${inputClass} ph-no-capture`}
        aria-describedby={`citizenship-err-${i}`}
      >
        <option value="">{t(locale, 'checkin.field.country.placeholder')}</option>
        {countries.map((c) => <option value={c.code}>{locale === 'en' ? c.en : c.et}</option>)}
      </select>
      <p class={errorClass} id={`citizenship-err-${i}`} data-error role="alert"></p>
    </div>

    <!-- Country of residence -->
    <div class="md:col-span-2">
      <label class={labelClass} for={`residence-${i}`}>{t(locale, 'checkin.field.residence')}</label>
      <select
        id={`residence-${i}`} data-field="country_of_residence" required
        class={`${inputClass} ph-no-capture`}
        aria-describedby={`residence-err-${i}`}
      >
        <option value="">{t(locale, 'checkin.field.country.placeholder')}</option>
        {countries.map((c) => <option value={c.code}>{locale === 'en' ? c.en : c.et}</option>)}
      </select>
      <p class={errorClass} id={`residence-err-${i}`} data-error role="alert"></p>
    </div>
  </div>

  <!-- § 24(3) travel document. Hidden until a non-EEA/CH citizenship is chosen.
       The statute also exempts third-country nationals holding Estonian
       residence, but that was judged too niche to ask about — so those guests
       are asked for details § 24(3) does not strictly require of them. See the
       guest privacy notice, which says they may have them deleted on request. -->
  <div class="mt-5 hidden" data-document-group>
    <h3 class="font-subtitle text-[clamp(22px,2.2vw,28px)] text-warm-dark mb-1">
      {t(locale, 'checkin.doc.heading')}
    </h3>
    <p class="font-body text-[16px] text-stone leading-relaxed mb-4">{t(locale, 'checkin.doc.note')}</p>

    <div class="grid gap-5 md:grid-cols-3">
      <div>
        <label class={labelClass} for={`doc-type-${i}`}>{t(locale, 'checkin.field.docType')}</label>
        <select id={`doc-type-${i}`} data-field="document_type" class={`${inputClass} ph-no-capture`}
                aria-describedby={`doc-type-err-${i}`}>
          <option value="">{t(locale, 'checkin.purpose.placeholder')}</option>
          <option value="passport">{t(locale, 'checkin.docType.passport')}</option>
          <option value="id_card">{t(locale, 'checkin.docType.id_card')}</option>
          <option value="other">{t(locale, 'checkin.docType.other')}</option>
        </select>
        <p class={errorClass} id={`doc-type-err-${i}`} data-error role="alert"></p>
      </div>

      <div>
        <label class={labelClass} for={`doc-number-${i}`}>{t(locale, 'checkin.field.docNumber')}</label>
        <input type="text" id={`doc-number-${i}`} data-field="document_number"
               maxlength="40" autocomplete="off" spellcheck="false"
               class={`${inputClass} ph-no-capture`} aria-describedby={`doc-number-err-${i}`} />
        <p class={errorClass} id={`doc-number-err-${i}`} data-error role="alert"></p>
      </div>

      <div>
        <label class={labelClass} for={`doc-country-${i}`}>{t(locale, 'checkin.field.docCountry')}</label>
        <select id={`doc-country-${i}`} data-field="document_country" class={`${inputClass} ph-no-capture`}
                aria-describedby={`doc-country-err-${i}`}>
          <option value="">{t(locale, 'checkin.field.country.placeholder')}</option>
          {countries.map((c) => <option value={c.code}>{locale === 'en' ? c.en : c.et}</option>)}
        </select>
        <p class={errorClass} id={`doc-country-err-${i}`} data-error role="alert"></p>
      </div>
    </div>
  </div>
</fieldset>
